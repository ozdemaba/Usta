{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"GOI Release Manifest",
  "type":"object",
  "required":["release_id","version","build_id","files","tests"],
  "properties":{
    "release_id":{"type":"string","minLength":1},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "build_id":{"type":"string","minLength":1},
    "files":{"type":"array","items":{"type":"object","required":["path","sha256","size"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size":{"type":"integer","minimum":0}}}},
    "tests":{"type":"array","items":{"type":"string"}},
    "migrations":{"type":"array","items":{"type":"string"}},
    "minimum_php":{"type":"string"},
    "minimum_wordpress":{"type":"string"},
    "rollback_release":{"type":["string","null"]}
  },
  "additionalProperties":true
}
